# Copia este fichero como .env y rellena tus valores.

# --- Basico -----------------------------------------------------------------
# URL publica de la app: es la que abren los alumnos desde WhatsApp.
# En local: http://localhost:8000 ; en produccion: https://asistencia.tudominio.com
BASE_URL=http://localhost:8000

# Clave para entrar al panel /panel y al alta de alumnos /admin. CAMBIALA.
ADMIN_KEY=pon-aqui-una-clave-tuya

# WhatsApp de la escuela que recibe el resumen (internacional, sin + ni espacios)
TELEFONO_EMPRESA=34600000000

# Con la base de demostracion, los resumenes van a este numero en vez de al real.
# Ponlo siempre que vayas a hacer pruebas: evita mandar mensajes a la escuela.
TELEFONO_PRUEBAS=

# --- Direccion publica fija (ngrok) ------------------------------------------
# Con esto la direccion NO cambia nunca, asi que los enlaces que envies siguen
# valiendo manana. Sin esto se usa un tunel de Cloudflare, que da una direccion
# nueva en cada arranque.
#
# 1. Crea una cuenta gratis en https://ngrok.com  (vale con Google o GitHub)
# 2. Copia tu token de https://dashboard.ngrok.com/get-started/your-authtoken
# 3. Crea tu dominio gratuito en https://dashboard.ngrok.com/domains
#    (el plan gratuito incluye uno, del estilo algo-algo.ngrok-free.app)
NGROK_TOKEN=
NGROK_DOMINIO=

# --- Lector de la puerta (control de acceso) ---------------------------------
# Clave que envia el lector RFID para poder fichar. Dejala vacia si no usas
# lector: asi el endpoint de fichaje queda desactivado.
# Genera una larga:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_KEY=

# --- Balance hombres / mujeres ----------------------------------------------
# Diferencia H-M a partir de la cual la clase se marca en ambar y en rojo
UMBRAL_AMBAR=2
UMBRAL_ROJO=4

# --- WhatsApp ---------------------------------------------------------------
# manual = sin coste ni alta en Meta; genera enlaces wa.me que pulsas tu.
# cloud  = envio automatico real con la WhatsApp Cloud API de Meta.
WA_MODE=manual

# Solo para WA_MODE=cloud (Meta for Developers > tu app > WhatsApp > API Setup)
WA_TOKEN=
WA_PHONE_ID=
WA_PLANTILLA=recordatorio_clase
WA_IDIOMA=es
WA_VERIFY_TOKEN=onstage-verify